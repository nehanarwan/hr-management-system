PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/hr_saas
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Optional. Without it the chatbot still works, but answers come from the
# built-in rule-based fallback instead of the Claude API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Comma separated list, or leave empty to allow same-origin only.
CORS_ORIGINS=
